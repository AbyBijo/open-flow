<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Theme.Material3.* XML themes come from com.google.android.material,
      not from androidx.compose.material3 (which is Kotlin-only). That
      dependency is now in app/build.gradle.kts, so DayNight resolves.
      Dark mode in the app itself is still handled by Compose.
    -->
    <style name="Theme.OpenFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!--
      Android 12 splash screen: the system draws this from the first frame,
      so the app never flashes a blank window on cold start. The splash
      icon is the launcher icon; after installSplashScreen() the activity
      switches to the normal theme.
    -->
    <style name="Theme.OpenFlow.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.OpenFlow</item>
    </style>
</resources>
